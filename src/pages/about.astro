---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import { url } from '../lib/url';
---

<Base title="About" description={`About ${site.name}: security engineer, photographer, and videographer in NYC.`}>
  <p class="eyebrow">About</p>
  <h1>Hi, I'm Johnny.</h1>
  <div class="prose">
    <p>Security engineer, photographer, videographer in NYC.</p>

    <p>This is the work I make outside of work.</p>

    <p>
      I build for communities I'm part of, mostly <a href={url('/projects/gotham-brand-system')}>Gotham Knights RFC</a>,
      New York's LGBT rugby club.
    </p>

    <h2>Get in touch</h2>
    <p>
      Email <a href={`mailto:${site.email}`}>{site.email}</a>, or find me on{' '}
      {site.links.map((l, i) => (
        <>
          <a href={l.href} target="_blank" rel="me noopener">{l.label}</a>{i < site.links.length - 1 ? ', ' : '.'}
        </>
      ))}
    </p>
  </div>
</Base>
