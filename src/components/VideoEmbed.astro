---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { parseVideoUrl } from '../lib/video';

interface Props {
  url: string;
  title: string;
  /** Local poster image. Optional for YouTube, recommended for Vimeo. */
  thumbnail?: ImageMetadata;
}

const { url, title, thumbnail } = Astro.props;
const video = parseVideoUrl(url);
const hasPoster = !!thumbnail || !!video.poster;
---

{hasPoster ? (
  <div class="video" data-video data-embed={video.embed} data-title={title}>
    <button class="poster" type="button" aria-label={`Play ${title}`}>
      {thumbnail ? (
        <Image src={thumbnail} alt="" width={1280} widths={[640, 1280]} sizes="(min-width: 1100px) 1040px, 100vw" />
      ) : (
        <img src={video.poster} alt="" loading="lazy" />
      )}
      <span class="play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
      </span>
    </button>
  </div>
) : (
  <div class="video">
    <iframe
      src={video.embed.replace('autoplay=1&', '')}
      title={title}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>
)}

<script>
  // Click-to-load facade: nothing from YouTube/Vimeo is requested until the
  // visitor presses play, which keeps the page fast and avoids third-party
  // cookies on load.
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((wrap) => {
    wrap.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = wrap.dataset.embed!;
      iframe.title = wrap.dataset.title ?? 'Video';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      wrap.replaceChildren(iframe);
    });
  });
</script>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
  }

  .video :global(iframe),
  .video :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .poster :global(img) {
    transition: transform 400ms ease;
  }

  .poster:hover :global(img) {
    transform: scale(1.03);
  }

  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgb(0 0 0 / 0.6);
    color: #fff;
    backdrop-filter: blur(4px);
    transition: background 150ms ease;
  }

  .poster:hover .play {
    background: #fff;
    color: #000;
  }
</style>
