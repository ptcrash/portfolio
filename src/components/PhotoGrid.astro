---
import { Image, getImage } from 'astro:assets';
import type { PhotoSection } from '../lib/photos';

interface Props {
  sections: PhotoSection[];
}

const { sections } = Astro.props;
const titled = sections.filter((s) => s.title);
const showNav = titled.length > 1;

// Pre-generate a large variant of every photo for the lightbox. Thumbnails in
// the grid are produced by <Image> with a responsive srcset.
const prepared = await Promise.all(
  sections.map(async (section) => {
    const n = section.photos.length;
    const photos = await Promise.all(
      section.photos.map(async (photo, i) => {
        const full = await getImage({ src: photo.src, width: 2000, format: 'webp', quality: 82 });
        const position = section.title ? `${section.title} · ${i + 1} of ${n}` : `${i + 1} of ${n}`;
        return {
          ...photo,
          full: full.src,
          alt: photo.alt || (section.title ? `${section.title}, photo ${i + 1}` : `Photo ${i + 1}`),
          caption: photo.alt || position,
        };
      }),
    );
    return { ...section, photos };
  }),
);

let eagerBudget = 6;
---

{showNav && (
  <nav class="jump" aria-label="Sections">
    {titled.map((s) => (
      <a href={`#${s.id}`}>{s.title}<span class="count">{s.photos.length}</span></a>
    ))}
  </nav>
)}

{prepared.map((section) => (
  <section class="photo-section" id={section.title ? section.id : undefined}>
    {section.title && <h2>{section.title}</h2>}
    <div class="grid">
      {section.photos.map((photo) => (
        <a
          href={photo.full}
          class="tile"
          data-lightbox-item
          data-alt={photo.alt}
          data-caption={photo.caption}
          style={`aspect-ratio: ${photo.src.width} / ${photo.src.height}`}
        >
          <Image
            src={photo.src}
            alt={photo.alt}
            width={800}
            widths={[400, 800, 1200]}
            sizes="(min-width: 1100px) 360px, (min-width: 700px) 45vw, 100vw"
            loading={eagerBudget-- > 0 ? 'eager' : 'lazy'}
          />
        </a>
      ))}
    </div>
  </section>
))}

<dialog class="lightbox" data-lightbox>
  <button class="close" data-lightbox-close aria-label="Close">×</button>
  <button class="nav prev" data-lightbox-prev aria-label="Previous photo">‹</button>
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
  <button class="nav next" data-lightbox-next aria-label="Next photo">›</button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const items = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-lightbox-item]'));

  if (dialog && items.length) {
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('figcaption')!;
    let index = 0;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const item = items[index];
      img.src = item.href;
      img.alt = item.dataset.alt ?? '';
      caption.textContent = item.dataset.caption ?? '';
      // Warm the neighbours so arrow navigation feels instant.
      for (const n of [index + 1, index - 1]) {
        const neighbour = items[(n + items.length) % items.length];
        new Image().src = neighbour.href;
      }
    };

    items.forEach((item, i) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(index + 1));

    dialog.addEventListener('click', (e) => {
      // Click on the backdrop (outside the figure) closes.
      if (e.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });

    // Basic swipe support on touch devices.
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(dx < 0 ? index + 1 : index - 1);
    });
  }
</script>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .jump a {
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    font-size: 0.9rem;
  }

  .jump a:hover {
    border-color: var(--accent);
  }

  .count {
    color: var(--fg-muted);
    margin-left: 0.4rem;
    font-size: 0.8rem;
  }

  .photo-section + .photo-section {
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  .photo-section h2 {
    font-size: 1.35rem;
    margin-bottom: 1rem;
    scroll-margin-top: 5rem;
  }

  .photo-section {
    scroll-margin-top: 5rem;
  }

  .grid {
    columns: 3 280px;
    column-gap: 1rem;
  }

  .tile {
    display: block;
    margin-bottom: 1rem;
    break-inside: avoid;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-elevated);
  }

  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 200ms ease;
  }

  .tile:hover :global(img) {
    opacity: 0.9;
  }

  .lightbox {
    border: 0;
    padding: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    background: rgb(0 0 0 / 0.92);
    color: #fff;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox figure {
    margin: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 3rem 4rem;
    pointer-events: none;
  }

  .lightbox img {
    max-width: 100%;
    max-height: calc(100dvh - 7rem);
    object-fit: contain;
    pointer-events: auto;
  }

  .lightbox figcaption {
    font-size: 0.9rem;
    opacity: 0.8;
    min-height: 1.2em;
  }

  .lightbox button {
    position: absolute;
    background: none;
    border: 0;
    color: #fff;
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.5rem 0.9rem;
    opacity: 0.7;
  }

  .lightbox button:hover {
    opacity: 1;
  }

  .close {
    top: 0.5rem;
    right: 0.5rem;
  }

  .nav {
    top: 50%;
    transform: translateY(-50%);
  }

  .prev {
    left: 0.25rem;
  }

  .next {
    right: 0.25rem;
  }

  @media (max-width: 600px) {
    .lightbox figure {
      padding: 3rem 0.5rem;
    }

    .nav {
      top: auto;
      bottom: 0.5rem;
      transform: none;
    }
  }
</style>
