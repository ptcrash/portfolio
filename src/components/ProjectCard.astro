---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url, formatDate } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, date, tags, cover } = project.data;
const href = url(`/projects/${project.id}`);
---

<article class="card">
  {cover && (
    <a href={href} class="cover" tabindex="-1" aria-hidden="true">
      <Image src={cover} alt="" width={1200} widths={[600, 1200]} sizes="(min-width: 900px) 50vw, 100vw" />
    </a>
  )}
  <div class="body">
    <div class="line">
      <h3><a href={href}>{title}</a></h3>
      <span class="meta">{formatDate(date)}</span>
    </div>
    <p class="muted">{description}</p>
    {tags.length > 0 && <p class="meta">{tags.join(' · ')}</p>}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .cover :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: opacity 200ms ease;
  }

  .card:hover .cover :global(img) {
    opacity: 0.85;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: var(--measure);
  }

  .body p {
    margin: 0;
  }

  .line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  h3 {
    margin: 0;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
</style>
