---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url, formatDate } from '../lib/url';

interface Props {
  album: CollectionEntry<'photography'>;
  count?: number;
}

const { album, count } = Astro.props;
const { title, date, cover, location } = album.data;
const href = url(`/photography/${album.id}`);
---

<a class="album" href={href}>
  <Image
    src={cover}
    alt=""
    width={1200}
    widths={[600, 1200]}
    sizes="(min-width: 900px) 50vw, 100vw"
  />
  <span class="line">
    <strong>{title}</strong>
    <span class="meta">
      {formatDate(date)}{location && ` · ${location}`}{count !== undefined && ` · ${count} photos`}
    </span>
  </span>
</a>

<style>
  .album {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    text-decoration: none;
  }

  .album :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: opacity 200ms ease;
  }

  .album:hover :global(img) {
    opacity: 0.85;
  }

  .line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  strong {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }
</style>
